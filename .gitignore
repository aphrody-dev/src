# Root Workspace Secret Guard (C:\src)
.env
.env.*
!.env.example
!.env.template
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*.p12
.credentials.json
service-account*.json
node_modules/
target/
dist/
graphify-out/
.worktrees/

# Allowlist: the root repo is the manifest of the monorepo (units are submodules, upstreams are pinned in src.lock.json)
/*
!/.agents/
# dist-generated release workflow (dist-workspace.toml)
!/.github/
# Repo-wide cargo build settings only; credentials stay in $CARGO_HOME, never here.
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/.cargo/neoverse-512tvb.toml
!/.claude/
!/.claude-plugin/
/.claude/skills
/.claude/settings.local.json
!/docs/
!/src/
# Brand sources and generated assets (assets/brand, `ay brand build`).
!/assets/
!/apps/
!/packages/
!/crates/
!/infra/
!/tools/
!/third_party/
!/plugins/
!/conformance/
/conformance/upstream/
/conformance/results/
!/rust-toolchain.toml
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.graphifyignore
!/.env.example
!/DEPS
!/DEPS.rules
!/depot-artifacts.toml
!/MAINTAINERS
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/README.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/justfile
!/Cargo.toml
!/Cargo.lock
!/deny.toml
!/identity.toml
!/package.json
!/tsconfig.json
# Single monorepo version (docs/packaging/VERSIONING.md, ay release freeze).
!/VERSION
!/bun.lock
!/bunfig.toml
!/pyproject.toml
!/uv.lock
!/src.lock.json
!/tools.toml
!/dist-workspace.toml


# third_party clones stay untracked (pinned in src.lock.json); only the ecosystem manifest is versioned.
!/third_party/
/third_party/*
!/third_party/ECOSYSTEM.toml
# Miroir texte des sources de design sous licence libre (docs/design/sources.toml, scripts/design-mirror.ts).
!/third_party/design-mirror/
!/scripts/

packages/machine/matrix/bin/

# Large binary design sources (Figma exports, >100 MB): reproducible, not in git
assets/*.fig
assets/*.zip
apps/aphrody/NUL
apps/.lst-*
# ay graph build outputs over 100 MB stay local (regenerate: ay graph build -o docs/nextjs/graph third_party/next.js)
/docs/*/graph/graph.json
/docs/*/graph/graph.html
/docs/*/graph/graph.graphml
/docs/*/graph/cypher.txt
