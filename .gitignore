# Root Workspace Secret Guard (C:\src)
.env
.env.*
!.env.example
!.env.template
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*.p12
.credentials.json
service-account*.json
node_modules/
target/
dist/
graphify-out/

# Allowlist: the root repo is the manifest of the monorepo (units are submodules, upstreams are pinned in src.lock.json)
/*
!/.agents/
# dist-generated release workflow (dist-workspace.toml)
!/.github/
# Repo-wide cargo build settings only; credentials stay in $CARGO_HOME, never here.
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/.claude/
/.claude/skills
/.claude/settings.local.json
!/.repo/
!/.repo/manifests/
!/.repo/manifest.xml
!/docs/
!/apps/
!/packages/
!/crates/
!/infra/
!/tools/
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.mcp.json
!/.graphifyignore
!/.env.example
!/DEPS
!/MAINTAINERS
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/README.md
!/justfile
!/Cargo.toml
!/Cargo.lock
!/Dockerfile
!/compose.yaml
!/.dockerignore
!/flake.nix
!/flake.lock
!/package.json
!/bun.lock
!/install.ps1
!/install.sh
!/deploy.ps1
!/deploy.sh
!/deploy.toml
!/src.lock.json
!/tools.toml
!/dist-workspace.toml
!/.gitlab-ci.yml
!/cloudbuild.yaml

# .NET build output (infra/winnt-sdk)
infra/winnt-sdk/**/bin/
infra/winnt-sdk/**/obj/

packages/pi-opencode/native/*.dll
packages/ai-os/submodules/
