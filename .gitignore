# Root Workspace Secret Guard (C:\src)
.env
.env.*
!.env.example
!.env.template
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*.p12
.credentials.json
service-account*.json
node_modules/
target/
dist/
graphify-out/

# Allowlist: the root repo is the manifest of the monorepo (units are submodules, upstreams are pinned in src.lock.json)
/*
!/.agents/
!/docs/
!/apps/
!/packages/
!/crates/
!/infra/
!/.gitignore
!/.gitmodules
!/.env.example
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/README.md
!/justfile
!/package.json
!/install.ps1
!/install.sh
!/deploy.ps1
!/deploy.sh
!/deploy.toml
!/src.lock.json
