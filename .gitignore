# Root Workspace Secret Guard (C:\src)
.env
.env.*
!.env.example
!.env.template
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*.p12
.credentials.json
service-account*.json
node_modules/
target/
dist/
graphify-out/

# Allowlist: the root repo is the manifest of the monorepo (units are submodules, upstreams are pinned in src.lock.json)
/*
!/.agents/
# dist-generated release workflow (dist-workspace.toml)
!/.github/
# Repo-wide cargo build settings only; credentials stay in $CARGO_HOME, never here.
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/.cargo/neoverse-512tvb.toml
!/.claude/
/.claude/skills
/.claude/settings.local.json
!/.repo/
!/.repo/manifests/
!/.repo/manifest.xml
!/docs/
!/apps/
!/packages/
!/crates/
!/infra/
!/tools/
!/plugins/
!/third_party/
!/licenses/
!/conformance/
/conformance/upstream/
/conformance/results/
!/rust-toolchain.toml
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.graphifyignore
!/.env.example
!/DEPS
!/MAINTAINERS
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/README.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/justfile
!/Cargo.toml
!/Cargo.lock
!/deny.toml
!/flake.nix
!/flake.lock
!/package.json
!/bun.lock
!/install.ps1
!/install.sh
!/deploy.ps1
!/deploy.sh
!/deploy.toml
!/src.lock.json
!/tools.toml
!/dist-workspace.toml
!/.gitlab-ci.yml
!/cloudbuild.yaml

# .NET build output (infra/winnt-sdk)
infra/winnt-sdk/**/bin/
infra/winnt-sdk/**/obj/

# third_party clones stay untracked (pinned in src.lock.json); only the ecosystem manifest is versioned.
!/third_party/
/third_party/*
!/third_party/ECOSYSTEM.toml
!/scripts/
