{
  "description": "aphrody-nhitl: auto-approve with deny list, log notifications, continue open work, session digest, learn capture",
  "hooks": {
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 10, "onFailure": "continue" }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 10, "onFailure": "continue" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 5, "async": true }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 10 }] }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 10 },
          { "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/learn-capture.ts"], "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 5 },
          { "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/learn-auto.ts"], "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"], "timeout": 5 },
          { "type": "command", "command": "bun", "args": ["${CLAUDE_PLUGIN_ROOT}/src/learn-capture.ts"], "timeout": 10 }
        ]
      }
    ]
  }
}
