{
  "spec": "geist.components",
  "domain": "components",
  "verified": "2026-11-13",
  "sources": [
    {
      "url": "https://vercel.com/geist/introduction",
      "license": "Propriétaire Vercel (https://vercel.com/legal/terms) : lecture seule ; noms de props et valeurs repris comme faits, descriptions réécrites, aucun code ni asset"
    },
    {
      "url": "https://vercel.com/geist/<composant>",
      "license": "Propriétaire Vercel : 75 pages lues en text/markdown le 2026-11-13"
    }
  ],
  "rules": [
    {
      "id": "geist.comp.package",
      "level": "MAY",
      "rule": "Les composants Geist sont publiés pour React sous @vercel/geistcn ; dans src ils ne sont pas une dépendance (cible web = Material Web), seulement une référence de comportement.",
      "source": "https://vercel.com/geist/introduction"
    },
    {
      "id": "geist.comp.button-vs-link",
      "level": "MUST",
      "rule": "Bouton pour une action qui modifie un état ; lien stylé en bouton pour une navigation qui change l'URL ; menu ou bouton scindé quand plusieurs actions liées partagent une ligne.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.button-label",
      "level": "SHOULD",
      "rule": "Le libellé nomme le résultat (verbe + objet : Deploy Project, Invite Member), jamais un verbe nu ni OK/Confirm ; un bouton destructif et son toast se répondent (Delete Project puis Project deleted).",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.loading-in-place",
      "level": "MUST",
      "rule": "État de chargement porté par le contrôle lui-même : il reste focusable, garde son libellé et annonce l'occupation (aria-busy) au lieu d'être remplacé par un spinner.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.disabled-explained",
      "level": "SHOULD",
      "rule": "Désactiver seulement si l'action est impossible maintenant (entrée manquante, droits) et expliquer pourquoi dans une infobulle.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.icon-only-name",
      "level": "MUST",
      "rule": "Tout contrôle icône seule porte un nom accessible qui décrit l'action et sa cible (Copy deployment URL), pas l'icône ; un contrôle avec texte visible ne reçoit pas d'aria-label.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.hover-delay",
      "level": "SHOULD",
      "rule": "Infobulles et cartes contextuelles s'ouvrent au survol et au focus clavier après un délai d'environ 150 ms pour ne pas clignoter lors d'un balayage ; Échap ferme et rend le focus au déclencheur.",
      "value": "150ms",
      "source": "https://vercel.com/geist/tooltip"
    },
    {
      "id": "geist.comp.overlay-focus",
      "level": "MUST",
      "rule": "Modale, tiroir, panneau latéral, calendrier et listes déroulantes piègent le focus pendant l'ouverture et le rendent au déclencheur à la fermeture ; le titre est relié par aria-labelledby.",
      "source": "https://vercel.com/geist/modal"
    },
    {
      "id": "geist.comp.cancel-literal",
      "level": "SHOULD",
      "rule": "Le bouton de renoncement d'une modale s'appelle littéralement Cancel (Annuler) pour rester stable d'un flux destructif à l'autre.",
      "source": "https://vercel.com/geist/modal"
    },
    {
      "id": "geist.comp.destructive-gate",
      "level": "MUST",
      "rule": "Une suppression irréversible exige la saisie exacte d'une phrase de confirmation ; la phrase et le champ sont exclus de la traduction automatique (translate=no) pour que la comparaison exacte reste possible.",
      "source": "https://vercel.com/geist/destructive-action-modal"
    },
    {
      "id": "geist.comp.live-regions",
      "level": "MUST",
      "rule": "Toasts, erreurs asynchrones, chargements et décomptes de résultats s'annoncent en aria-live polite ; assertive est réservé aux erreurs bloquantes.",
      "source": "https://vercel.com/geist/toast"
    },
    {
      "id": "geist.comp.toast-no-nav",
      "level": "MUST-NOT",
      "rule": "Ne pas placer de navigation essentielle dans un toast : il disparaît avant d'être atteint au clavier.",
      "source": "https://vercel.com/geist/toast"
    },
    {
      "id": "geist.comp.group-fieldset",
      "level": "MUST",
      "rule": "Cases à cocher, radios et choiceboxes liés sont regroupés dans fieldset + legend ; une case de sélection de ligne sans libellé visible reçoit un aria-label nommant la ligne.",
      "source": "https://vercel.com/geist/checkbox"
    },
    {
      "id": "geist.comp.color-not-only",
      "level": "MUST",
      "rule": "La couleur n'est jamais le seul signal (sélection, seuil, statut) : texte, coche ou titre redondant obligatoire.",
      "source": "https://vercel.com/geist/status-dot"
    },
    {
      "id": "geist.comp.reduced-motion",
      "level": "MUST",
      "rule": "Spinners, points de chargement, squelettes et vidéos en lecture auto respectent prefers-reduced-motion ; un seul indicateur animé par ligne.",
      "source": "https://vercel.com/geist/loading-dots"
    },
    {
      "id": "geist.comp.progress-throttle",
      "level": "SHOULD",
      "rule": "Limiter la mise à jour d'aria-valuenow d'une barre de progression à environ une fois par seconde.",
      "value": "1s",
      "source": "https://vercel.com/geist/progress"
    },
    {
      "id": "geist.comp.keyboard-menus",
      "level": "MUST",
      "rule": "Menus : flèches haut/bas, Début/Fin, Entrée/Espace, recherche par première lettre (le libellé visible vient en premier), Échap ferme ; menu contextuel ouvrable par Maj+F10 ou touche menu, un seul niveau de sous-menu pour les actions destructives.",
      "source": "https://vercel.com/geist/menu"
    },
    {
      "id": "geist.comp.tabs-keys",
      "level": "MUST",
      "rule": "Onglets : flèches gauche/droite déplacent le focus, Entrée/Espace activent, anneau de focus visible sur l'onglet actif, aria-label sur la liste si aucun titre visible.",
      "source": "https://vercel.com/geist/tabs"
    },
    {
      "id": "geist.comp.decorative-frames",
      "level": "MUST",
      "rule": "Cadres de présentation (navigateur, téléphone, couverture de livre, guides de grille) sont aria-hidden et sans contrôle focusable ; le sens est porté par l'image interne et son texte alternatif.",
      "source": "https://vercel.com/geist/browser"
    },
    {
      "id": "geist.comp.sheet-measures",
      "level": "SHOULD",
      "rule": "Panneau latéral en variante inset par défaut : marge 12 px, coins 16 px, hauteur pleine, largeur maximale 512 px ; bouton Close visible car un clic extérieur ne ferme pas.",
      "value": { "margin": "12px", "radius": "16px", "maxWidth": "512px" },
      "source": "https://vercel.com/geist/sheet"
    },
    {
      "id": "geist.comp.avatar-pairing",
      "level": "SHOULD",
      "rule": "Taille d'avatar accordée au texte voisin : 20-24 px avec label-14, 32 px avec label-16, 48-64 px en en-tête ou onboarding.",
      "value": {
        "label-14": "20-24px",
        "label-16": "32px",
        "header": "48-64px"
      },
      "source": "https://vercel.com/geist/avatar"
    },
    {
      "id": "geist.comp.url-state",
      "level": "SHOULD",
      "rule": "Les filtres de liste vivent dans l'URL (partage, rechargement, précédent/suivant).",
      "source": "https://vercel.com/geist/filter-params"
    },
    {
      "id": "geist.comp.web-guidelines",
      "level": "MUST",
      "rule": "Les règles transverses d'interface (focus, cibles, formulaires, contenu, performance perçue) ne sont pas dupliquées ici : appliquer la skill vercel-agent-skills:web-design-guidelines (fork aphrody-labs/agent-skills, .agents/skills/web-design-guidelines).",
      "source": "https://vercel.com/design/guidelines"
    }
  ],
