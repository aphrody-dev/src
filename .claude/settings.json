{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__*"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@anthropic-plugin-directory": true,
    "gopls-lsp@anthropic-plugin-directory": true,
    "typescript-lsp@anthropic-plugin-directory": true,
    "clangd-lsp@anthropic-plugin-directory": true,
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "commit-commands@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "cloudflare@anthropic-plugin-directory": true,
    "github@claude-plugins-official": true
  },
  "env": {
    "AGENT_GUARD": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/.agents/scripts/pre-tool-guard.ts\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
