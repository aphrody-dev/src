{
  "name": "@aphrody/aphrody",
  "version": "1.0.0",
  "description": "aphrody.com - Aphrody brand homepage, search with package catalog, and runtime benchmarks, in pure Bun web standards",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "build:aot": "bun build --compile --minify --bytecode server.ts --outfile dist/aphrody-web.exe",
    "dev": "bun run server.ts",
    "start": "bun run server.ts",
    "test": "bun test",
    "pm": "bun run pm.ts",
    "nie:archive": "bun run nie-archive.ts",
    "bench": "bun run src/benchmark/stored.ts",
    "fmt": "bun fmt",
    "check": "bun check",
    "deploy:dry": "bunx wrangler@4.161.0 deploy --dry-run"
  },
  "dependencies": {},
  "devDependencies": {}
}
