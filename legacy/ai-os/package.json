{
  "name": "@aphrody/ai-os",
  "version": "2.1.0",
  "description": "Sole Monorepo AI, POSIX/Unix OS, NixOS Store, WASM32/WebGPU & Unified Context-Optimized MCP Owner in pure oven-sh/bun v1.4.4 + Rust 2024",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./security": "./src/nexus/security.ts",
    "./brain": "./src/nexus/brain-memory.ts",
    "./skills": "./src/nexus/skills-hub.ts",
    "./triad": "./src/triad/index.ts",
    "./extracted": "./src/extracted/index.ts",
    "./posix": "./src/posix/unix-os.ts",
    "./nix": "./src/nix/store.ts",
    "./wasm-webgpu": "./src/wasm-webgpu/index.ts",
    "./benchmark": "./src/benchmark/arena.ts",
    "./fusion-specs": "./src/protocols/fusion-specs.ts"
  },
  "bin": {
    "ai-os": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "sync": "bun run src/cli.ts sync",
    "distill": "bun run src/cli.ts nix distill",
    "benchmark": "bun run src/cli.ts benchmark --write",
    "extract": "bun run src/cli.ts extract",
