{
  "name": "@aphrody/knowledge-engine",
  "version": "1.0.0",
  "description": "Unified Context7 v2 + Multi-Hop Deep Research + Deterministic Fact-Checker + Monorepo Docs & Skills Generator + Continuous AGY Session Reviewer in pure Bun v1.4.4",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
