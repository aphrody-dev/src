# Deterministic Line-Ending & Binary Normalization across Git, Chromium, Kernel & AOSP
* text=auto eol=lf

# Windows batch & PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# POSIX shell, Rust, TypeScript, Go, C/C++, CUDA, Kernel patches & XML manifests
*.sh text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.go text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cu text eol=lf
*.patch text eol=lf
*.diff text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.wgsl text eol=lf
DEPS text eol=lf
MAINTAINERS text eol=lf
justfile text eol=lf

# Binary artifacts
*.wasm binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff2 binary
*.sqlite binary
*.zst binary
