# ==============================================================================
# C:\src\.env.example — Sovereign Monorepo & Toolchain Environment Template
# Managed by C:\src\packages\env-kit (`env-kit doctor`, `env-kit accounts status`, `env-kit set <KEY> <VAL>`)
# ZERO SECRETS IN THIS FILE. Real values live in NTFS ACL-locked C:\src\.env.
# ==============================================================================

# --- 0. Workspace, Portability & Agent Runtime (non-secret, all optional) ---
# Monorepo root. Default: nearest ancestor holding src.lock.json (justfile dir for `just`).
SRC_ROOT=
# Agent PreToolUse guard (.agents/scripts/pre-tool-guard.ts): off (default) | warn | enforce
AGENT_GUARD=off
# Container workflow (Dockerfile / compose.yaml). No Debian: Alpine = light, Arch Linux = heavy.
SRC_IMAGE=aphrody/monorepo-dev:local
SRC_RUNTIME_IMAGE=aphrody/monorepo-runtime:local
ALPINE_VERSION=3.23
# Pin to a dated tag (base-devel-YYYYMMDD.0.N) for reproducible Arch rebuilds.
ARCH_TAG=base-devel
BUN_VERSION=1.4.4
GO_VERSION=1.27.0
RUST_TOOLCHAIN=nightly
JUST_VERSION=1.58.0
# First-party units compiled into the images (static musl). rust-stack needs third_party/, build it in `dev`.
CLI_UNITS=tools/archguard crates/xtask crates/depot

# --- 1. Aphrody 3-Principal Multi-Google & GCP Identity Matrix (#468000409790) ---
GOOGLE_CLOUD_PROJECT=aphrody
GCLOUD_PROJECT=aphrody
CLOUDSDK_CORE_PROJECT=aphrody
APHRODY_GCP_PROJECT_NUMBER=468000409790
GOOGLE_CLOUD_REGION=europe-west1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/aphro/AppData/Roaming/gcloud/application_default_credentials.json

# Principal 1: Autonomous AI Account (Gemini, Spark, Hermes, OpenClaw, Drive gdrive-yoyo, NotebookLM)
APHRODY_AI_GOOGLE_ACCOUNT=yoyo.aphrody@gmail.com
CLOUDSDK_CONFIG_AI=ai-yoyo
APHRODY_AI_RCLONE_REMOTE=gdrive-yoyo
GEMINI_AGENT_GOOGLE_ACCOUNT=yoyo.aphrody@gmail.com
SPARK_AGENT_GOOGLE_ACCOUNT=yoyo.aphrody@gmail.com
HERMES_AGENT_GOOGLE_ACCOUNT=yoyo.aphrody@gmail.com
OPENCLAW_AGENT_GOOGLE_ACCOUNT=yoyo.aphrody@gmail.com

# Principal 2: Personal Developer & Root GCP Owner Account (Yoyo)
APHRODY_OWNER_GOOGLE_ACCOUNT=yohanpierre15@gmail.com
CLOUDSDK_CONFIG_OWNER=owner-yohan

# Principal 3: Organization & Production Infrastructure Master Identity
APHRODY_ORG_GOOGLE_ACCOUNT=contact@aphrody.com
CLOUDSDK_CONFIG_ORG=org-contact

# Principal 4: Headless NHITL CI/CD Service Account
APHRODY_SA_GOOGLE_ACCOUNT=yolo-automation@aphrody.iam.gserviceaccount.com
CLOUDSDK_CONFIG_SA=sa-automation

# --- 2. Organization Accounts & Infrastructure Surfaces (`contact@aphrody.com`) ---
# 2a. Google Workspace
GOOGLE_WORKSPACE_DOMAIN=aphrody.com
GOOGLE_WORKSPACE_ADMIN_EMAIL=contact@aphrody.com

