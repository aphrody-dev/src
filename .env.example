# --- 5. Rust / Crates.io / sccache ---
CARGO_REGISTRY_TOKEN=<REDACTED_OR_SET_VIA_ENV_KIT>
CARGO_HOME=C:/Users/aphro/.cargo
RUSTUP_HOME=C:/Users/aphro/.rustup
CARGO_TARGET_DIR=C:/src/.cargo-target
RUSTC_WRAPPER=sccache
CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# --- 6. Python / uv / PyPI ---
UV_PUBLISH_TOKEN=<REDACTED_OR_SET_VIA_ENV_KIT>
TWINE_USERNAME=__token__
TWINE_PASSWORD=<REDACTED_OR_SET_VIA_ENV_KIT>
UV_CACHE_DIR=C:/Users/aphro/AppData/Local/uv/cache
UV_LINK_MODE=hardlink
PYTHONUTF8=1

# --- 7. .NET / NuGet ---
NUGET_API_KEY=<REDACTED_OR_SET_VIA_ENV_KIT>
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1

# --- 8. C / C++ / CUDA / Vulkan Native Toolchain ---
CC=cl.exe
CXX=cl.exe
CMAKE_GENERATOR=Ninja
VCPKG_ROOT=C:/src/vcpkg
VCPKG_DEFAULT_BINARY_CACHE=C:/Users/aphro/AppData/Local/vcpkg/archives
CUDA_PATH=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.4
VULKAN_SDK=C:/VulkanSDK/1.4.363.0

# --- 9. Go & Lua ---
GOPATH=C:/Users/aphro/go
GOPROXY=https://proxy.golang.org,direct
CGO_ENABLED=1
LUA_PATH=C:/src/packages/env-kit/loaders/lua/?.lua;C:/src/packages/env-kit/loaders/lua/?/init.lua;;
LUA_CPATH=C:/src/packages/env-kit/loaders/lua/?.dll;;

