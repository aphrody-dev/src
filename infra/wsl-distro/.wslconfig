# %USERPROFILE%\.wslconfig template for the aphrody CachyOS WSL 2 kernel (copy by hand; the repo never edits the PC).
# Keys: learn.microsoft.com/windows/wsl/wsl-config (MicrosoftDocs/WSL@50342fc5). Kernel and modules VHD come from
# infra/wsl-distro/kernel/build-kernel.sh on fr1, copied to C:\src\target\wsl\ (gitignored).
# wslc.exe containers ignore this file: see infra/wsl-distro/wslc-settings.yaml.
[wsl2]
kernel=C:\\src\\target\\wsl\\bzImage-aphrody-cachyos
kernelModules=C:\\src\\target\\wsl\\modules-aphrody-cachyos.vhdx
memory=24GB
processors=24
networkingMode=mirrored
dnsTunneling=true
autoProxy=true
firewall=true
guiApplications=true
gpuSupport=true
nestedVirtualization=true
kernelCommandLine=mitigations=off nowatchdog

[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
hostAddressLoopback=true
