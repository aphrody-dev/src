# aphrody WSL 2 kernel fragment, merged by kernel/build-kernel.sh (scripts/kconfig/merge_config.sh) over:
#   base  = microsoft/WSL2-Linux-Kernel@a9891719 (linux-msft-wsl-6.18.y) arch/x86/configs/config-wsl
#           (WSL boots without initramfs: VMBus, storage, ext4, 9p, virtiofs, dxgkrnl stay built in, as Microsoft ships them)
#   tree  = CachyOS/linux cachyos-7.4-rc2-2 + CachyOS/kernel-patches@21d72141 7.4/sched/0001-bore-cachy.patch
#           + drivers/hv/dxgkrnl and include/uapi/misc/d3dkmthk.h from the Microsoft tree above
# CachyOS choices follow CachyOS/linux-cachyos@8e308d0a linux-cachyos-rc/PKGBUILD defaults (bore, 1000 Hz, full preempt,
# THP always, ThinLTO); CPU = generic x86-64-v3, not native: fr1 builds, the PC (i7-13700F) runs it.
CONFIG_LOCALVERSION="-aphrody-cachyos-wsl2"

# CachyOS
CONFIG_CACHY=y
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_PREEMPT_NONE is not set
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
# CONFIG_X86_NATIVE_CPU is not set
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_THIN=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NTSYNC=y

# WSL 2 guest (already in config-wsl; restated so the merge fails loudly if the tree drops them)
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_TIMER=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_PCI_HYPERV=y
CONFIG_PAGE_REPORTING=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_BINFMT_MISC=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_PMEM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_FS_DAX=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_PASSTHROUGH=y

# GPU-PV for WSLg and Mesa d3d12/dzn (/dev/dxg)
CONFIG_DXGKRNL=y
CONFIG_DRM=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
