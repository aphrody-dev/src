# Allowlist build context for infra/docker/Dockerfile (BuildKit reads <Dockerfile>.dockerignore next to it).
# Everything is excluded, then only what the images compile from is re-included. Secrets never enter.
*
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!.cargo/config.toml
!crates/
!package.json
!bun.lock
!packages/
!infra/cloudflare/workers/api-gateway/
!apps/aphrody/
!apps/yolo/
!apps/r2-site/
!docs/ALPHABET.md
!docs/reviews/
!third_party/forks.txt
!assets/brand/brand.toml
!assets/brand/src/
!assets/brand/gen/
**/target/
**/node_modules/
**/dist/
**/.git
**/graphify-out/
**/var/
**/.env
**/.env.*
**/*.pem
**/*.key
**/secrets*
