# CMake toolchain: x86_64-pc-windows-msvc from Linux with clang-cl + lld-link and an xwin splat in
# $XWIN (default /xwin). Same layout as infra/vcpkg/toolchains/windows-llvm.cmake on Windows.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{XWIN})
  set(ENV{XWIN} /xwin)
endif()
set(XWIN $ENV{XWIN})
set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_LINKER lld-link)
set(CMAKE_AR llvm-lib)
set(CMAKE_RC_COMPILER llvm-rc)
set(CMAKE_MT llvm-mt)
set(_xw "/imsvc${XWIN}/crt/include /imsvc${XWIN}/sdk/include/ucrt /imsvc${XWIN}/sdk/include/um /imsvc${XWIN}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "--target=x86_64-pc-windows-msvc ${_xw}")
set(CMAKE_CXX_FLAGS_INIT "--target=x86_64-pc-windows-msvc ${_xw} /EHsc")
set(_xl "/libpath:${XWIN}/crt/lib/x86_64 /libpath:${XWIN}/sdk/lib/um/x86_64 /libpath:${XWIN}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_xl}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_xl}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_xl}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
