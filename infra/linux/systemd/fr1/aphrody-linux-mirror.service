# Weekly refresh of the partial GKI and ChromiumOS kernel mirror on fr1 (infra/linux/android/mirror.sh,
# docs/linux/ANDROID-CHROMIUMOS.md). Installed by infra/upstream/install.sh with @SRC@ filled in.
[Unit]
Description=Aphrody partial mirror: GKI and ChromiumOS kernels
After=network-online.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/bin/sh @SRC@/infra/linux/android/mirror.sh
TimeoutStartSec=3h
