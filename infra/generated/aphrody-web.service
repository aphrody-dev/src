[Unit]
Description=Aphrody Web Production Service (Bun v1.4.4 Native)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/aphrody/monorepo/apps/aphrody
ExecStart=/home/ubuntu/.local/bin/bun run server.ts
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3000
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
