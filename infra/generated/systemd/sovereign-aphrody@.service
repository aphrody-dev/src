# Hardened systemd unit for aphrody (Blue/Green template: @blue -> 13000, @green -> 23000)
[Unit]
Description=Sovereign Service aphrody (%i slot)
After=network-online.target wireguard-wg0.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=sovereign/aphrody-%i
WorkingDirectory=/opt/sovereign/aphrody/current-%i
EnvironmentFile=-/etc/sovereign/aphrody.env
EnvironmentFile=-/etc/sovereign/aphrody-%i.port.env
ExecStart=/opt/sovereign/aphrody/current-%i/aphrody
Restart=always
RestartSec=2s
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
