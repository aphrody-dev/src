# Hardened systemd unit for shenron (Blue/Green template: @blue -> 13100, @green -> 23100)
[Unit]
Description=Sovereign Service shenron (%i slot)
After=network-online.target wireguard-wg0.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=sovereign/shenron-%i
WorkingDirectory=/opt/sovereign/shenron/current-%i
EnvironmentFile=-/etc/sovereign/shenron.env
EnvironmentFile=-/etc/sovereign/shenron-%i.port.env
ExecStart=/opt/sovereign/shenron/current-%i/shenron
Restart=always
RestartSec=2s
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
