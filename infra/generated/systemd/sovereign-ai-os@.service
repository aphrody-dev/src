# Hardened systemd unit for ai-os (Blue/Green template: @blue -> 14000, @green -> 24000)
[Unit]
Description=Sovereign Service ai-os (%i slot)
After=network-online.target wireguard-wg0.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=sovereign/ai-os-%i
WorkingDirectory=/opt/sovereign/ai-os/current-%i
EnvironmentFile=-/etc/sovereign/ai-os.env
EnvironmentFile=-/etc/sovereign/ai-os-%i.port.env
ExecStart=/opt/sovereign/ai-os/current-%i/ai-os
Restart=always
RestartSec=2s
MemoryMax=4G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
