# Hardened systemd unit for rust-stack (Blue/Green template: @blue -> 14100, @green -> 24100)
[Unit]
Description=Sovereign Service rust-stack (%i slot)
After=network-online.target wireguard-wg0.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=sovereign/rust-stack-%i
WorkingDirectory=/opt/sovereign/rust-stack/current-%i
EnvironmentFile=-/etc/sovereign/rust-stack.env
EnvironmentFile=-/etc/sovereign/rust-stack-%i.port.env
ExecStart=/opt/sovereign/rust-stack/current-%i/rust-stack
Restart=always
RestartSec=2s
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
