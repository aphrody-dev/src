# Versioned copy of fr2 /etc/fleet/firewall.nft (loaded by fleet-firewall.service). Its generator (infra/fleet/fleet.ts of the
# former Bun OS repo) no longer exists: this file is now the source; deploy: scp to /etc/fleet/firewall.nft + systemctl restart fleet-firewall.
# Layering on fr2: inet fleet (prio -10, host filter) + inet fr2_edge (prio -5, 80/443 Cloudflare+fleet only) + inet f2b-table (fail2ban sshd).
#!/usr/sbin/nft -f
# Generated by `bun infra/fleet/fleet.ts firewall dbfr` from infra/fleet/fleet.toml. Do not edit on the host.
# Only the public interface (ens3) is filtered; mesh, loopback and container bridges are trusted.
table inet fleet
delete table inet fleet
table inet fleet {
  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname != "ens3" accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { icmp, ipv6-icmp } accept
    ip saddr { 51.77.147.152, 51.255.162.6, 72.60.186.43 } accept
    ip6 saddr { 2001:41d0:404:200::4d8e, 2001:41d0:305:2100::a461, 2a02:4780:28:8e1e::1 } accept
    tcp dport { 22, 80, 443 } accept
    udp dport { 443, 45667 } accept
    counter drop
  }
}
