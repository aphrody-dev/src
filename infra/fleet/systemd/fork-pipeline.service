[Unit]
Description=Fork pipeline: poll upstreams, sync forks, bump consumers (fr1)
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=3h
ExecStart=/usr/local/bin/aphrody-heavy /home/ubuntu/.local/bin/bun /usr/local/lib/fork-pipeline.ts
