# Hourly probe of the ssh 22 closing criteria (Access ssh + mesh ssh). Source: infra/fleet/bin/ssh22-probe.sh
[Unit]
Description=ssh 22 closing criteria probe (Access + mesh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=19
ExecStart=/usr/local/bin/ssh22-probe.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=fleet-ssh22
