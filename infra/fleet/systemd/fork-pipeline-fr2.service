[Unit]
Description=Fork pipeline shard 0/2: poll upstreams, sync forks, bump consumers
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
Nice=19
IOSchedulingClass=idle
CPUQuota=200%
MemoryMax=4G
TimeoutStartSec=3h
ExecStart=/home/ubuntu/.local/bin/bun /usr/local/lib/fork-pipeline.ts --shard 0/2
