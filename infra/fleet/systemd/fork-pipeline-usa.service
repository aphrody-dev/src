[Unit]
Description=Fork pipeline shard 1/2: poll upstreams, sync forks, bump consumers
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=root
Environment=HOME=/root
Nice=19
IOSchedulingClass=idle
CPUQuota=200%
MemoryMax=4G
TimeoutStartSec=3h
ExecStart=/usr/local/bin/bun /usr/local/lib/fork-pipeline.ts --shard 1/2
