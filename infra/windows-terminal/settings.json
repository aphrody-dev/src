{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": {
        "action": "splitPane",
        "split": "right"
      },
      "id": "User.SplitRight"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "down"
      },
      "id": "User.SplitDown"
    },
    {
      "command": {
        "action": "commandPalette"
      },
      "id": "User.Palette"
    },
    {
      "command": {
        "action": "quakeMode"
      },
      "id": "User.Quake"
    },
    {
      "command": {
        "action": "newTab",
        "profile": "Git Bash"
      },
      "id": "User.NewGitBash"
    }
  ],
  "centerOnLaunch": true,
  "compatibility.allowHeadless": true,
  "copyFormatting": "none",
  "copyOnSelect": false,
  "defaultProfile": "{7d8b7341-8f4d-4c56-91f0-4ad220d41db1}",
  "disabledProfileSources": [
    "BunOS",
    "nu",
    "Microsoft.WSL"
  ],
  "firstWindowPreference": "persistedLayoutAndContent",
  "keybindings": [
    {
      "id": "Terminal.CopyToClipboard",
      "keys": "ctrl+c"
    },
    {
      "id": "User.SplitDown",
      "keys": "alt+shift+minus"
    },
    {
      "id": "Terminal.PasteFromClipboard",
      "keys": "ctrl+v"
    },
    {
      "id": "Terminal.DuplicatePaneAuto",
      "keys": "alt+shift+d"
    },
    {
      "id": "User.Palette",
      "keys": "ctrl+shift+p"
    },
    {
      "id": "User.SplitRight",
      "keys": "alt+shift+plus"
    },
    {
      "id": "User.Quake",
      "keys": "win+sc(41)"
    },
    {
      "id": "User.NewGitBash",
      "keys": "ctrl+shift+g"
    }
  ],
  "language": "fr-FR",
  "launchMode": "maximized",
  "newTabMenu": [
    {
      "type": "remainingProfiles"
    }
  ],
  "profiles": {
    "defaults": {
      "antialiasingMode": "cleartype",
      "colorScheme": "Aphrody M3 Dark",
      "cursorShape": "bar",
      "elevate": true,
      "font": {
        "face": "Google Sans Code, Symbols Nerd Font Mono, Material Symbols Rounded",
        "features": {
          "calt": 1,
          "liga": 1
        },
        "size": 20
      },
      "historySize": 50000
    },
