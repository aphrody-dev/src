{
  "name": "@aphrody/monorepo",
  "version": "2026.11.0",
  "private": true,
  "description": "Aphrody Sovereign Monorepo Root - Linux/Git/Chromium/depot_tools/Bun-v1.4.4 Workspace Architecture",
  "workspaces": {
    "packages": [
      "packages/*",
      "infra/ffi-bridge"
    ],
    "catalog": {
      "@types/bun": "1.4.4"
    }
  },
  "scripts": {
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "arch": "ay arch check --strict",
    "doctor": "ay arch check --strict && ay doctor && ay doctor --deps && env-kit doctor && src-deploy doctor",
    "test:packages": "bun test packages/env-kit packages/wck",
    "deploy": "src-deploy up --all --dry-run",
    "deploy:live": "src-deploy up --all",
    "deps": "ay doctor --deps"
  },
  "packageManager": "bun@canary",
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  }
}
