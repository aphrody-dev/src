{
  "name": "@aphrody/monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Aphrody Sovereign Monorepo Root - Linux/Git/Chromium/depot_tools/Bun-v1.4.4 Workspace Architecture",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/aphrody",
      "apps/r2-site",
      "apps/yolo",
      "apps/nt",
      "apps/nt/modules/web",
      "infra/cloudflare/workers/*"
    ],
    "catalog": {
      "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
      "@cloudflare/workers-types": "5.20261113.1",
      "@material-symbols/svg-400": "0.49.0",
      "@material/material-color-utilities": "0.4.0",
      "@material/web": "2.5.0",
      "@types/bun": "1.4.4",
      "@webgpu/types": "0.1.74",
      "material-symbols": "0.49.0",
      "tree-sitter-c": "0.24.1",
      "tree-sitter-cpp": "0.23.4",
      "vite": "8.3.8",
      "web-tree-sitter": "0.27.2"
    }
  },
  "scripts": {
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "arch": "ay arch check --strict",
    "doctor": "ay arch check --strict && ay doctor && ay doctor --deps && env-kit doctor && src-deploy doctor",
    "test:packages": "bun test packages/env-kit packages/wck",
    "deploy": "src-deploy up --all --dry-run",
    "deploy:live": "src-deploy up --all",
    "deps": "ay doctor --deps"
  },
  "packageManager": "bun@canary",
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  }
}
