# checkdeps layer rules (see docs/ARCHITECTURE.md). Inherited by subdirectories.
layer = 3
# lore-error-set(-macro) is Lore's own error crate (upstream Epic code): Lore crates only (root -rule).
lore-credential: +crates/lore-error-set
lore-credential: +crates/lore-error-set-macro
lore-server: +crates/lore-error-set
lore-server: +crates/lore-error-set-macro
lore-revision: +crates/lore-error-set
lore-revision: +crates/lore-error-set-macro
lore-storage: +crates/lore-error-set
lore-storage: +crates/lore-error-set-macro
lore-notification: +crates/lore-error-set
lore-notification: +crates/lore-error-set-macro
lore: +crates/lore-error-set
lore: +crates/lore-error-set-macro
lore-aws: +crates/lore-error-set
lore-aws: +crates/lore-error-set-macro
lore-base: +crates/lore-error-set
lore-base: +crates/lore-error-set-macro
lore-telemetry: +crates/lore-error-set
lore-telemetry: +crates/lore-error-set-macro
lore-transport: +crates/lore-error-set
lore-transport: +crates/lore-error-set-macro
lore-error-set: +crates/lore-error-set-macro
