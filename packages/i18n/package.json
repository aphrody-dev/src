{
  "name": "@aphrody/i18n",
  "version": "0.1.0",
  "description": "Shared i18n layer for src: JSON catalogs with an ICU MessageFormat subset, t() with fallback to en, Accept-Language negotiation, check/extract CLI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*": "./locales/*"
  },
  "bin": {
    "aphrody-i18n": "./src/cli.ts"
  },
  "scripts": {
    "check": "bun check",
    "fmt": "bun fmt",
    "test": "bun test",
    "i18n:check": "bun run src/cli.ts check"
  },
  "dependencies": {},
  "devDependencies": {},
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/src.git",
    "directory": "packages/i18n"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
