- name: UserSettingsFile-0
  type: Microsoft.WinGet/UserSettingsFile
  properties:
    settings: {}
- name: AdminSettings-0
  type: Microsoft.WinGet/AdminSettings
  metadata:
    winget:
      securityContext: "elevated"
  properties:
    settings:
      LocalManifestFiles: false
      ProxyCommandLineOptions: false
      BypassCertificatePinningForMicrosoftStore: false
      InstallerHashOverride: false
      LocalArchiveMalwareScanOverride: false
      ConfigurationProcessorPath: false
- name: Microsoft.DSC.Transitional/RunCommandOnSet_wa9tq9gr
  type: Microsoft.DSC.Transitional/RunCommandOnSet
  metadata:
    description: "Configuration de Microsoft.Windows.Settings"
  dependsOn:
  - Microsoft.WinGet/Package_d9bq4va0
  properties:
    arguments:
    - "-NoProfile"
    - "-NoLogo"
    - "-Command"
    - "if (-not (Get-Module -ListAvailable -Name Microsoft.Windows.Settings)) { Install-Module
      -Name Microsoft.Windows.Settings -Confirm:$False -Force -AllowPrerelease -AllowClobber
      }"
    executable: "pwsh"
- name: Microsoft.Windows.Settings/WindowsSettings_sexo326t
  type: Microsoft.Windows.Settings/WindowsSettings
  metadata:
    description: "Configuration de Microsoft.Windows.Settings/WindowsSettings"
    winget:
      securityContext: "elevated"
  dependsOn:
  - Microsoft.DSC.Transitional/RunCommandOnSet_wa9tq9gr
  properties:
    SystemColorMode: "Dark"
    DeveloperMode: true
    TaskbarAlignment: "Middle"
    AppColorMode: "Dark"
