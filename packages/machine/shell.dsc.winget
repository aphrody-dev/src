# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Remplacement reproductible de Git Bash et pwsh (preuves : C:\Users\aphro\nt\docs\research\shell-replacement.md).
# Ressource DSC v3 native de winget 1.30.300 : Microsoft.WinGet/Package (schéma : `winget dscv3 package --schema`).
# Appliquer : winget configure -f C:\src\configuration\shell.dsc.winget --accept-configuration-agreements
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: niubash
    type: Microsoft.WinGet/Package
    properties:
      id: Unixwin.Niubash
      source: winget
      version: "1.5.0"
      installMode: silent
      acceptAgreements: true
  - name: coreutils
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.Coreutils
      source: winget
      version: "2026.9.3"
      installMode: silent
      acceptAgreements: true
