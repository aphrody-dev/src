# packages/machine/shells/bash/inputrc — readline (Git Bash ; niubash lit aussi $INPUTRC / ~/.inputrc). brush (reedline) l'ignore.
# Variables vérifiées par `bind -v` (GNU readline 8.3 de Git Bash 5.3.15, et niubash 1.5.0) : docs/shell/bash-setup.md.
set input-meta on
set output-meta on
set convert-meta off
set enable-bracketed-paste on
set bell-style none
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on
set skip-completed-text on
# Flèches haut/bas : recherche dans l'historique par préfixe ; Ctrl+flèches : mot par mot.
"\e[A": history-search-backward
"\e[B": history-search-forward
"\e[1;5C": forward-word
"\e[1;5D": backward-word
