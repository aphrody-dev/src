# généré par packages/machine/src/shells.ts depuis shells/env.toml — ne pas éditer
# fish 4.x (Linux seulement : pas de build Windows natif amont). Sourcé par fish/config.fish.
set -gx SRC_ROOT "$HOME"'/src'
set -gx AY_SHELL_CACHE "$HOME"'/.cache/shell'
set -gx XDG_CONFIG_HOME "$HOME"'/.config'
set -gx XDG_CACHE_HOME "$HOME"'/.cache'
set -gx XDG_DATA_HOME "$HOME"'/.local/share'
set -gx XDG_STATE_HOME "$HOME"'/.local/state'
set -gx LANG 'C.UTF-8'
set -gx PYTHONUTF8 '1'
set -gx EDITOR 'nvim'
set -gx VISUAL 'nvim'
set -gx PAGER 'less'
set -gx CARGO_HOME "$HOME"'/.cargo'
set -gx RUSTUP_HOME "$HOME"'/.rustup'
set -gx BUN_INSTALL "$HOME"'/.bun'
set -gx DENO_NO_UPDATE_CHECK '1'
set -gx npm_config_fund 'false'
set -gx npm_config_audit 'false'
set -gx npm_config_update_notifier 'false'
set -gx DO_NOT_TRACK '1'
set -gx DOTNET_CLI_TELEMETRY_OPTOUT '1'
set -gx POWERSHELL_TELEMETRY_OPTOUT '1'
set -gx POWERSHELL_UPDATECHECK 'Off'
set -gx NEXT_TELEMETRY_DISABLED '1'
set -gx TURBO_TELEMETRY_DISABLED '1'
set -gx ASTRO_TELEMETRY_DISABLED '1'
set -gx WRANGLER_SEND_METRICS 'false'
set -gx CHECKPOINT_DISABLE '1'
set -gx FZF_DEFAULT_COMMAND 'fd --type f --hidden --exclude .git --path-separator /'
fish_add_path -gPm "$HOME"'/.local/bin' "$CARGO_HOME"'/bin' "$BUN_INSTALL"'/bin'
