# golden vectors: strict grammar shared by every loader (one line per key, closed quotes)
PLAIN=plain
COMMENTED=plain # comment
SPACED=  spaced  
export EXPORTED=exp
WITH_EQ=a=b
HASH_IN_VALUE=a#b
DQ="quoted value"
DQ_COMMENT="quoted" # trailing
DQ_ESC="line\nnext\ttab \"q\" back\\slash"
SQ='single \n kept'
EMPTY=
  KEY_SPACES = v
