{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["bun"]
  },
  "include": ["src/**/*", "bin/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"]
}
