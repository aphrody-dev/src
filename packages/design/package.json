{
  "name": "@aphrody/design",
  "version": "0.1.0",
  "description": "Systeme de design unique du monorepo : tokens Material 3 (Material Color Utilities) depuis assets/brand/brand.toml, sorties CSS, Rust (GPUI), Zig, ANSI, Figma, DESIGN.md ; composants Material Web ; Material Symbols (SVG et police : sous-ensemble d ay brand build ; material-symbols ne sert qu au catalogue des noms).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.json": "./tokens/tokens.json",
    "./tokens.css": "./tokens/tokens.css",
    "./themes.css": "./tokens/themes.css",
    "./themes.json": "./tokens/themes.json",
    "./components": "./src/components.ts",
    "./symbols.css": "./src/symbols.css",
    "./bun-plugin": "./src/bun-plugin.ts",
    "./runtime": "./src/runtime.ts",
    "./web": "./src/web.ts"
  },
  "scripts": {
    "build": "bun run src/build.ts",
    "check": "bun run src/build.ts --check",
    "test": "bun test",
    "figma": "bun run src/figma.ts --modes 4",
    "themes": "bun run src/cli.ts themes",
    "screenshots": "bun run src/cli.ts screenshots",
    "lint": "bun run src/cli.ts lint DESIGN.md"
  },
  "dependencies": {
    "@material/material-color-utilities": "catalog:",
    "@material/web": "catalog:",
    "material-symbols": "catalog:"
  },
  "license": "MIT OR Apache-2.0"
}
