{
  "name": "@aphrody/chromium-bun",
  "version": "0.0.0",
  "private": true,
  "description": "CDP client, SSRF-guarded crawler, BM25 search shards, engine registry and runtime benchmarks, on bun",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search/index.ts",
    "./cdp": "./src/browser/cdp-client.ts",
    "./engines": "./src/engines/index.ts"
  },
  "bin": {
    "chromium-bun": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "bench": "bun run src/benchmarks/runner.ts",
    "inspect": "bun run src/audit/chromium-inspector.ts",
    "test": "bun test",
    "check": "bun check",
    "fmt": "bun fmt"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/src.git",
    "directory": "packages/chromium-bun"
  }
}
