{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["**/*.ts"],
  // bun-native.d.ts is the ambient header for packages without @types/bun; this
  // package loads @types/bun, and both together clash (e.g. Buffer.toString overloads).
  "exclude": ["node_modules", "bun-native.d.ts"]
}
