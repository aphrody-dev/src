{
  "name": "@aphrody/forge",
  "version": "1.1.0",
  "description": "Sovereign Rust + TypeScript Tri-Forge (GitHub + GitLab + Google Git + Arch Upstreams) CLI (frg)",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "frg": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "status": "bun run src/cli.ts status",
    "remotes": "bun run src/cli.ts remotes",
    "build": "bun build --compile src/cli.ts --outfile dist/frg.exe",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/core": "workspace:*"
  },
  "devDependencies": {},
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/src.git",
    "directory": "packages/forge"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
