{
  "$comment": "ai-os review (src/review, docs/reviews/README.md). Aucun modèle ni fournisseur ici : les voix ne déclarent que des familles de moteurs (expressions régulières sur les identifiants du registre : CLI d'agents + llm_models) et des classes de tâche de config/model-routing.json ; l'ordre réel vient de orch/select.ts (santé, refroidissements).",
  "threshold": 16,
  "timeout_s": 420,
  "max_bytes": 120000,
  "grounding_chars": 24000,
  "rounds": 4,
  "stale_rounds": 2,
  "voices": {
    "gemini": {
      "label": "Gemini",
      "stance": "voix Google : Chromium (styleguide, depot_tools, gn), Google eng-practices, guides de style Google, Python, Go, Android, ChromiumOS, Bazel. Tu défends les pratiques Google et tu cites la règle officielle qui fonde chaque grief.",
      "tasks": ["ci-review", "judge"],
      "only": ["^agy(:|$)", "gemini", "gemma"]
    },
    "claude": {
      "label": "Claude",
      "stance": "voix Rust et bun : sûreté mémoire, types, erreurs explicites, bun natif (aucun outil que bun remplace), tests bun, windows-rs. Tu défends Rust et bun et tu vérifies chaque affirmation dans le diff.",
      "tasks": ["ci-review", "judge"],
      "only": ["^claude(:|$)", "anthropic", "claude"]
    },
    "judge": {
      "label": "Juge",
      "stance": "juge neutre C, C++, assembleur et natif, hostile au code et jamais aux personnes. Tu contre-vérifies chaque grief des deux voix dans le diff, tu corriges l'accusation comme les plaideurs, et ta décision prime.",
      "tasks": ["judge"],
      "prefer": ["^claude(:|$)", "^codex(:|$)"],
      "after": ["gemini", "claude"]
    }
  },
  "topics": {
    "bun-ts": "\\.(ts|tsx|js|mjs|cjs)$|(^|/)(package\\.json|bunfig\\.toml|bun\\.lock)$",
    "rust": "\\.rs$|(^|/)Cargo\\.(toml|lock)$|rust-toolchain",
    "cpp": "\\.(c|cc|cpp|cxx|h|hh|hpp|ixx|cppm|asm|S)$",
    "python": "\\.py$",
    "go": "\\.go$|(^|/)go\\.(mod|sum)$",
    "shell-justfile": "\\.(sh|bash|ps1)$|(^|/)justfile$",
    "ci": "^\\.github/workflows/",
    "infra-fleet": "^infra/|docs/infra/",
    "cloudflare": "cloudflare|wrangler\\.(toml|jsonc?)$",
    "security": "auth|oauth|token|secret|vault|crypto|tls|gateway|relay/",
    "nhitl-agents": "agents?|nhitl|orch/|relay/|\\.claude/|AGENTS\\.md|CLAUDE\\.md",
    "docs-facts": "\\.md$",
    "chromium-google": "chromium|depot_tools|\\.gn$|\\.gni$|DEPS$|PRESUBMIT",
    "bazel": "(^|/)(BUILD|BUILD\\.bazel|WORKSPACE|MODULE\\.bazel)$|\\.bzl$",
    "android": "android|Android\\.bp$|\\.kt$|\\.kts$",
    "chromiumos": "chromiumos|ebuild$"
  },
