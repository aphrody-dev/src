{
  "sovereign-userspace-and-secret-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "bun run C:/src/.agents/scripts/pre-tool-guard.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
